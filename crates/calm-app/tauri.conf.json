{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CACalm",
  "version": "0.1.1",
  "identifier": "com.fathforce.cacalm",
  "build": {
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "CACalm",
        "width": 900,
        "height": 680,
        "minWidth": 700,
        "minHeight": 500,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
